{
  "manifest_version": 3,
  "name": "Text Refiner for WhatsApp Web",
  "version": "1.2.0",
  "description": "AI writing help for WhatsApp Web: refine drafts, draft replies, explain messages, catch up on chats. Not affiliated with WhatsApp.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Text Refiner settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
