{
  "manifest_version": 3,
  "name": "WhatsApp Text Refiner",
  "version": "1.1.0",
  "description": "Refine your WhatsApp Web drafts with Claude or OpenAI before you send them.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "WhatsApp Text Refiner settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
